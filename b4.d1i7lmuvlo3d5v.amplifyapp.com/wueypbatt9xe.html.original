    <script>
        (function() {
            var vpath = "/win";
            var attempts = 0;

            function fire() {
                attempts++;
                if (window.fathom && typeof window.fathom.trackPageview === "function") {
                    try {
                        window.fathom.trackPageview({
                            url: window.location.origin + vpath
                        });
                    } catch (_) {}
                    return;
                }
                if (attempts < 40) window.setTimeout(fire, 100);
            }
            fire();
        })();
    </script>
